# syntax=docker/dockerfile:1
#
# The published image, from prebuilt static binaries: the release workflow
# builds the musl binaries once per architecture (Dockerfile.build), lays them
# out as dist/linux-amd64/apigw and dist/linux-arm64/apigw, and builds this
# file without compiling anything. Same runtime as `Dockerfile`.

FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS stage
ARG TARGETARCH
COPY dist/linux-${TARGETARCH}/apigw /apigw
RUN chmod 0755 /apigw && mkdir -p /var/cache/apigw

# distroless/static ships the CA bundle that reqwest's platform verifier needs
# for HTTPS integrations.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5

LABEL org.opencontainers.image.source=https://github.com/smoketurner/amazon-apigateway-self-hosted
LABEL org.opencontainers.image.description="Self-hosted gateway that serves an existing Amazon API Gateway's routes"
LABEL org.opencontainers.image.licenses="Apache-2.0 OR MIT"

COPY --from=stage /apigw /apigw
COPY --from=stage --chown=nonroot:nonroot /var/cache/apigw /var/cache/apigw

# No APIGW_CONFIG_CACHE default: --domain-name rejects a cache, and a variable
# set here cannot be unset by a pod spec. /var/cache/apigw is there to point it at.
ENV APIGW_LISTEN=0.0.0.0:8443 \
    APIGW_ADMIN_LISTEN=0.0.0.0:9443
EXPOSE 8443 9443
ENTRYPOINT ["/apigw"]
