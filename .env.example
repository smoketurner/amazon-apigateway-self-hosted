# Environment for local runs (`make run`). Copy to .env (gitignored) and adjust.
# `apigw --help` lists every APIGW_* variable.

RUST_LOG=info
APIGW_LOG_FORMAT=text

# Exactly one source: a REST API stage, an HTTP API, or an OpenAPI export on disk.
# APIGW_REST_API_ID=a1b2c3d4e5
# APIGW_STAGE=prod
# APIGW_HTTP_API_ID=
# APIGW_OPENAPI_FILE=api.json

# TLS is required. For local use:
#   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
#     -keyout key.pem -out cert.pem -days 30 -subj /CN=localhost -addext subjectAltName=DNS:localhost
APIGW_TLS_CERT=cert.pem
APIGW_TLS_KEY=key.pem

APIGW_LISTEN=127.0.0.1:8443
# APIGW_ADMIN_LISTEN=127.0.0.1:9443
# APIGW_CONFIG_CACHE=.local/apigw-cache.json
# APIGW_INTEGRATION_OVERRIDES=overrides.json
# APIGW_STAGE_VARIABLE_backendHost=localhost:8080

# AWS credentials and region for downloading the API and invoking Lambda.
# AWS_REGION=us-east-1
# AWS_PROFILE=
