region      = "us-east-1"
name_prefix = "apigw-ref"
stage_name  = "ref"

# Opt-in features that bill hourly or change account-wide settings.
enable_logging                 = false
manage_account_cloudwatch_role = false
enable_cache_cluster           = false
enable_vpc_link                = false

# apigw on ECS Fargate against the reference REST API (bills while the task runs).
enable_ecs_gateway = false
# Leave these two unset to have the stack create a public-subnet VPC for the task.
# vpc_id                    = "vpc-0123456789abcdef0"
# ecs_gateway_subnet_ids    = ["subnet-0123456789abcdef0"]
# ecs_gateway_allowed_cidrs = ["203.0.113.7/32"]
# ecs_gateway_image_tag     = "dev"

# apigw as a Lambda function behind a public function URL. Set the tag after
# the first apply has created the repository and the image is pushed.
enable_lambda_gateway = false
# lambda_gateway_image_tag = "dev"
