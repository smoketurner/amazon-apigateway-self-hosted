openapi: "3.0.1"
info:
  title: "${name}"
  version: "1.0"
paths:
  /$default:
    x-amazon-apigateway-any-method:
      isDefaultRoute: true
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "${echo_invocation_uri}"
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "2.0"
  /lambda-v2/{proxy+}:
    x-amazon-apigateway-any-method:
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "${echo_invocation_uri}"
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "2.0"
  /lambda-v1/{proxy+}:
    x-amazon-apigateway-any-method:
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "${echo_invocation_uri}"
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "1.0"
  # Request parameter mapping on a Lambda proxy integration, for whether API
  # Gateway applies it to the event
  /lambda-mapped/{id}:
    get:
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "${echo_invocation_uri}"
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "2.0"
        requestParameters:
          "append:header.x-mapped": "$request.path.id"
          "overwrite:querystring.fixed": "literal"
  /http-proxy/{proxy+}:
    x-amazon-apigateway-any-method:
      x-amazon-apigateway-integration:
        type: http_proxy
        httpMethod: ANY
        uri: "https://$${stageVariables.echo_host}/http-proxy/{proxy}"
        payloadFormatVersion: "1.0"
        timeoutInMillis: 5000
        requestParameters:
          "overwrite:header.x-echo-secret": "$stageVariables.echo_secret"
  /mapped/{id}:
    get:
      x-amazon-apigateway-integration:
        type: http_proxy
        httpMethod: GET
        uri: "https://$${stageVariables.echo_host}/http-mapped/{id}"
        payloadFormatVersion: "1.0"
        timeoutInMillis: 5000
        requestParameters:
          "overwrite:path": "/http-mapped/$request.path.id"
          "overwrite:querystring.fixed": "literal"
          "append:querystring.appended": "$context.stage"
          "append:header.x-appended": "$context.stage"
          "overwrite:header.x-echo-secret": "$stageVariables.echo_secret"
        responseParameters:
          "200":
            "append:header.x-reference-response": "mapped"
  # An integration host that does not resolve, for HTTP API's answer
  /broken/unresolvable:
    get:
      x-amazon-apigateway-integration:
        type: http_proxy
        httpMethod: GET
        uri: "https://$${stageVariables.unresolvable_host}/unresolvable"
        payloadFormatVersion: "1.0"
        timeoutInMillis: 5000
  # Integrations that answer after their timeout, for the HTTP API's 503
  /timeout:
    get:
      x-amazon-apigateway-integration:
        type: http_proxy
        httpMethod: GET
        uri: "https://$${stageVariables.echo_host}/timeout"
        payloadFormatVersion: "1.0"
        timeoutInMillis: 50
        requestParameters:
          "overwrite:header.x-echo-secret": "$stageVariables.echo_secret"
  /lambda-timeout:
    get:
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "${echo_invocation_uri}"
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "2.0"
        timeoutInMillis: 50
  # Integration subtypes, answering with the service's own response
  /subtype/sqs:
    post:
      x-amazon-apigateway-integration:
        type: aws_proxy
        integrationSubtype: SQS-SendMessage
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "1.0"
        requestParameters:
          QueueUrl: "${queue_url}"
          MessageBody: "$request.body"
  /subtype/eventbridge:
    post:
      x-amazon-apigateway-integration:
        type: aws_proxy
        integrationSubtype: EventBridge-PutEvents
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "1.0"
        requestParameters:
          Source: "apigw.reference"
          DetailType: "parity"
          Detail: "$request.body"
          EventBusName: "${event_bus_name}"
  /subtype/stepfunctions:
    post:
      x-amazon-apigateway-integration:
        type: aws_proxy
        integrationSubtype: StepFunctions-StartSyncExecution
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "1.0"
        requestParameters:
          StateMachineArn: "${state_machine_arn}"
          Input: "$request.body"
  /subtype/kinesis:
    post:
      x-amazon-apigateway-integration:
        type: aws_proxy
        integrationSubtype: Kinesis-PutRecord
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "1.0"
        requestParameters:
          StreamName: "${stream_name}"
          Data: "$request.body"
          PartitionKey: "parity"
  # The other integration subtypes; the empty queue keeps their answers alike
  /subtype/sqs-receive:
    post:
      x-amazon-apigateway-integration:
        type: aws_proxy
        integrationSubtype: SQS-ReceiveMessage
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "1.0"
        requestParameters:
          QueueUrl: "${empty_queue_url}"
          MaxNumberOfMessages: "1"
          WaitTimeSeconds: "0"
  /subtype/sqs-delete:
    post:
      x-amazon-apigateway-integration:
        type: aws_proxy
        integrationSubtype: SQS-DeleteMessage
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "1.0"
        requestParameters:
          QueueUrl: "${empty_queue_url}"
          ReceiptHandle: "$request.querystring.handle"
  /subtype/sqs-purge:
    post:
      x-amazon-apigateway-integration:
        type: aws_proxy
        integrationSubtype: SQS-PurgeQueue
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "1.0"
        requestParameters:
          QueueUrl: "${empty_queue_url}"
  /subtype/stepfunctions-start:
    post:
      x-amazon-apigateway-integration:
        type: aws_proxy
        integrationSubtype: StepFunctions-StartExecution
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "1.0"
        requestParameters:
          StateMachineArn: "${state_machine_arn}"
          Input: "$request.body"
  /subtype/stepfunctions-stop:
    post:
      x-amazon-apigateway-integration:
        type: aws_proxy
        integrationSubtype: StepFunctions-StopExecution
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "1.0"
        requestParameters:
          ExecutionArn: "$request.querystring.execution"
          Cause: "parity"
  /subtype/appconfig:
    post:
      x-amazon-apigateway-integration:
        type: aws_proxy
        integrationSubtype: AppConfig-GetConfiguration
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "1.0"
        requestParameters:
          Application: "${appconfig_application}"
          Environment: "${appconfig_environment}"
          Configuration: "${appconfig_configuration}"
          ClientId: "parity"
  /throttled:
    get:
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "${echo_invocation_uri}"
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "2.0"
  /authz/jwt:
    get:
      security:
        - jwt: []
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "${echo_invocation_uri}"
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "2.0"
  /authz/jwt-scoped:
    get:
      security:
        - jwt:
            - aws.cognito.signin.user.admin
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "${echo_invocation_uri}"
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "2.0"
  /authz/lambda-simple:
    get:
      security:
        - lambda_simple: []
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "${echo_invocation_uri}"
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "2.0"
  /authz/lambda-iam:
    get:
      security:
        - lambda_iam: []
      x-amazon-apigateway-integration:
        type: aws_proxy
        httpMethod: POST
        uri: "${echo_invocation_uri}"
        credentials: "${invoke_role_arn}"
        payloadFormatVersion: "2.0"
components:
  securitySchemes:
    jwt:
      type: oauth2
      flows: {}
      x-amazon-apigateway-authorizer:
        type: jwt
        jwtConfiguration:
          issuer: "${cognito_issuer}"
          audience:
            - "${cognito_client_id}"
        identitySource: "$request.header.Authorization"
    lambda_simple:
      type: apiKey
      name: x-auth
      in: header
      x-amazon-apigateway-authorizer:
        type: request
        identitySource: "$request.header.x-auth"
        authorizerUri: "${authorizer_invocation_uri}"
        authorizerCredentials: "${invoke_role_arn}"
        authorizerPayloadFormatVersion: "2.0"
        authorizerResultTtlInSeconds: 0
        enableSimpleResponses: true
    lambda_iam:
      type: apiKey
      name: x-auth
      in: header
      x-amazon-apigateway-authorizer:
        type: request
        identitySource: "$request.header.x-auth"
        authorizerUri: "${authorizer_invocation_uri}"
        authorizerCredentials: "${invoke_role_arn}"
        authorizerPayloadFormatVersion: "1.0"
        authorizerResultTtlInSeconds: 0
