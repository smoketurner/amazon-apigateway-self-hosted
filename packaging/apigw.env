# Configuration for apigw.service. Every apigw flag has an APIGW_* variable:
# run `apigw --help` or see
# https://github.com/smoketurner/amazon-apigateway-self-hosted
#
# After editing: systemctl enable --now apigw   (or: systemctl restart apigw)

# --- API to serve: set exactly one source ---
#APIGW_REST_API_ID=
#APIGW_HTTP_API_ID=
#APIGW_STAGE=
# Comma-separated custom domain names. Comment out APIGW_CONFIG_CACHE below
# when using this: a domain-name gateway keeps no cache.
#APIGW_DOMAIN_NAMES=
#APIGW_OPENAPI_FILE=

# --- TLS: every listener is TLS. Files must be readable by group apigw and
# are re-read when they change. ---
APIGW_TLS_CERT=/etc/apigw/tls/tls.crt
APIGW_TLS_KEY=/etc/apigw/tls/tls.key

# --- Listeners ---
#APIGW_LISTEN=0.0.0.0:8443
# /healthz and /routes. /routes lists every backend target: keep it private.
APIGW_ADMIN_LISTEN=127.0.0.1:9443

# Last-known-good API definition, used when AWS is unreachable at startup.
APIGW_CONFIG_CACHE=/var/cache/apigw/config.json

# --- AWS ---
# apigw resolves credentials and region the way the AWS CLI and SDKs do:
# environment variables, shared config and credentials files, a profile, SSO,
# credential_process, a web identity token, then container and instance
# metadata. Set only what this host uses.
#AWS_REGION=
#AWS_PROFILE=
# The apigw user has no home directory, so shared files are read only when
# these name them.
#AWS_CONFIG_FILE=
#AWS_SHARED_CREDENTIALS_FILE=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
#AWS_ROLE_ARN=
#AWS_WEB_IDENTITY_TOKEN_FILE=
# IAM Roles Anywhere instead: apigw exchanges this certificate (end-entity
# first, then intermediates) and its private key for the role's credentials,
# re-reading both on every refresh. All five are required together.
#APIGW_ROLES_ANYWHERE_CERTIFICATE=/etc/apigw/roles-anywhere/tls.crt
#APIGW_ROLES_ANYWHERE_PRIVATE_KEY=/etc/apigw/roles-anywhere/tls.key
#APIGW_ROLES_ANYWHERE_TRUST_ANCHOR_ARN=
#APIGW_ROLES_ANYWHERE_PROFILE_ARN=
#APIGW_ROLES_ANYWHERE_ROLE_ARN=
#APIGW_ROLES_ANYWHERE_SESSION_SECONDS=3600
