{
  "source": "hand_written",
  "api": "rest_policy",
  "stage": "ref",
  "stage_variables": {
    "echo_host": "echo.lambda-url.us-east-1.on.aws"
  },
  "openapi": {
    "openapi": "3.0.1",
    "info": {
      "title": "apigw-ref-rest-policy",
      "version": "1.0"
    },
    "x-amazon-apigateway-policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": "*",
          "Action": "execute-api:Invoke",
          "Resource": "arn:aws:execute-api:us-east-1:[account-id]:apiid/*"
        },
        {
          "Effect": "Deny",
          "Principal": "*",
          "Action": "execute-api:Invoke",
          "Resource": "arn:aws:execute-api:us-east-1:[account-id]:apiid/*/GET/ip-denied",
          "Condition": {
            "IpAddress": {
              "aws:SourceIp": [
                "0.0.0.0/0",
                "::/0"
              ]
            }
          }
        }
      ]
    },
    "paths": {
      "/open": {
        "get": {
          "x-amazon-apigateway-integration": {
            "type": "mock",
            "passthroughBehavior": "when_no_match",
            "requestTemplates": {
              "application/json": "{\"statusCode\": 200}"
            },
            "responses": {
              "default": {
                "statusCode": "200",
                "responseTemplates": {
                  "application/json": "{\"route\":\"open\"}"
                }
              }
            }
          }
        }
      },
      "/ip-denied": {
        "get": {
          "x-amazon-apigateway-integration": {
            "type": "mock",
            "passthroughBehavior": "when_no_match",
            "requestTemplates": {
              "application/json": "{\"statusCode\": 200}"
            },
            "responses": {
              "default": {
                "statusCode": "200",
                "responseTemplates": {
                  "application/json": "{\"route\":\"ip-denied\"}"
                }
              }
            }
          }
        }
      }
    }
  }
}
