{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "restApiId": { "type": "string" },
        "httpApiId": { "type": "string" },
        "domainNames": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "domainCertSource": { "enum": ["files", "acm"] },
        "openapiFile": { "type": "string" },
        "type": { "enum": ["rest", "http"] },
        "stage": { "type": "string" },
        "basePath": { "type": "string" },
        "stageVariables": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9_]+$" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "region": { "type": "string" },
        "profile": { "type": "string" },
        "configFile": { "type": "string" },
        "sharedCredentialsFile": { "type": "string" },
        "existingSecret": { "type": "string" },
        "webIdentity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roleArn": { "type": "string" },
            "audience": { "type": "string", "minLength": 1 },
            "expirationSeconds": { "type": "integer", "minimum": 600 }
          }
        },
        "rolesAnywhere": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trustAnchorArn": {
              "type": "string",
              "pattern": "^$|^arn:[^:]+:rolesanywhere:[^:]+:[^:]+:trust-anchor/.+$"
            },
            "profileArn": {
              "type": "string",
              "pattern": "^$|^arn:[^:]+:rolesanywhere:[^:]+:[^:]+:profile/.+$"
            },
            "roleArn": { "type": "string", "pattern": "^$|^arn:[^:]+:iam::[^:]+:role/.+$" },
            "sessionSeconds": { "type": "integer", "minimum": 900, "maximum": 43200 },
            "existingSecret": { "type": "string" },
            "certManager": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "commonName": { "type": "string" },
                "issuerRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "kind": { "type": "string" },
                    "group": { "type": "string" }
                  }
                }
              }
            },
            "csiDriver": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "issuerRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "kind": { "type": "string" },
                    "group": { "type": "string" }
                  }
                },
                "commonName": { "type": "string" },
                "dnsNames": { "type": "string" },
                "keyAlgorithm": { "enum": ["RSA", "ECDSA"] },
                "keySize": { "enum": [256, 384, 521, 2048, 3072, 4096] },
                "duration": { "type": "string", "minLength": 1 },
                "fsGroup": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "issuerRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string" },
                "group": { "type": "string" }
              }
            },
            "dnsNames": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scrapeAnnotations": { "type": "boolean" },
        "tlsConfig": { "type": "object" },
        "podMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "protocol": { "enum": ["http/protobuf", "grpc"] },
        "serviceName": { "type": "string" },
        "resourceAttributes": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "istio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destinationRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "sni": { "type": "string" }
          }
        }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 31 },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "extraArgs": { "type": "array", "items": { "type": "string" } },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" }
  }
}
